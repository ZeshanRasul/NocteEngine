###############################################################################
# Compiler / Linker intermediates
###############################################################################
# NOTE: this rule is for MSVC object files, but it also matches Wavefront .obj
# 3-D models. Scene meshes (Models/exterior.obj, src/Models/Bistro.obj) are
# therefore NOT in the repository and must be downloaded separately - see the
# asset instructions in README.md. Do not "fix" this by committing the meshes;
# they are ~620 MB and are freely redistributable from the original sources.
*.obj
*.idb
*.pdb
*.ilk
*.exp
*.lib
*.dll
*.exe
*.manifest
*.iobj
*.ipdb
*.rsp
*.tlog

###############################################################################
# Logs and reports
###############################################################################
*.log
*.tlog
*.lastbuildstate
*.cachefile
*.VC.db-shm
*.VC.db-wal

###############################################################################
# DirectX / HLSL related
###############################################################################
# compiled shader objects
*.cso
# auto-generated shader headers
*.hlsl.h
*.fxc.log
*.hlsli.tmp
*.shadercache
*.dxil
*.dxbc

###############################################################################
# OS and Editor Noise
###############################################################################
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.idea/
*.swp
*.bak
*.tmp
*.old
*.orig

